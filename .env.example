# Alexandria - Supabase Edge Function Environment Variables
# Copy to .env and fill in your values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-api-key
MCP_ACCESS_KEY=generate-a-random-secret-here

# REQUIRED: owner fail-closed auth (JWT and API key both resolve to this owner).
# Without it the Edge Function rejects every request. Get it from
# Authentication -> Users in the Supabase dashboard.
ALEXANDRIA_OWNER_USER_ID=

# REQUIRED for the coverage-capture cron (handler is default-deny without it).
# Send it as the x-coverage-capture-secret header from your scheduler.
COVERAGE_CAPTURE_SECRET=

# AI Models
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSION=2048
CLASSIFICATION_MODEL=openai/gpt-4o-mini

# Provider bounds (optional - defaults shown)
# PROVIDER_TOTAL_DEADLINE_MS=8000
# PROVIDER_PER_ATTEMPT_TIMEOUT_MS=4000
# PROVIDER_MAX_RETRIES=2
# PROVIDER_INITIAL_BACKOFF_MS=100

# CORS (optional - empty = allow all origins for dev)
# ALLOWED_ORIGINS=https://your-project.supabase.co,https://claude.ai

# Google OAuth (for health-connect/sync.py - optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth file paths (optional - defaults to importer directory)
# GOOGLE_TOKEN_PATH=/path/to/token.json
# GOOGLE_CLIENT_SECRETS_PATH=/path/to/client_secret.json

# Local development only (supabase start; used by the test harness)
# LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# LOCAL_SUPABASE_SERVICE_ROLE_KEY=from `supabase status`
# LOCAL_SUPABASE_ANON_KEY=from `supabase status`
